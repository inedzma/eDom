<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.DetaljiPrijaveController"
            prefWidth="1100" prefHeight="700"
            stylesheets="@../styles/detalji-prijave-style.css">

    <top>
        <VBox spacing="8" styleClass="header">
            <Label fx:id="lblNaslov" text="Detalji prijave" styleClass="header-title"/>
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="header-meta">
                <Label fx:id="lblInfo" styleClass="header-subtitle"/>
                <Label fx:id="lblPrijavaId" styleClass="header-pill"/>
                <Label fx:id="lblStatus" styleClass="status-pill status-info"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <GridPane styleClass="main-grid" hgap="18" vgap="18">
            <columnConstraints>
                <ColumnConstraints percentWidth="65"/>
                <ColumnConstraints percentWidth="35"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS"/>
            </rowConstraints>

            <!-- LIJEVO: bodovanje i dokumenti -->
            <VBox spacing="12" styleClass="card" GridPane.columnIndex="0">

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Bodovanje" styleClass="card-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblKompletiranostText" styleClass="muted"/>
                </HBox>
                <ProgressBar fx:id="pbKompletiranost" progress="0.0" maxWidth="Infinity" styleClass="progress"/>

                <TableView fx:id="tblBodovanje" styleClass="table-modern" prefHeight="220">
                    <columns>
                        <TableColumn fx:id="colStavka" text="Stavka" prefWidth="220"/>
                        <TableColumn fx:id="colObrazlozenje" text="Obrazloženje" prefWidth="300"/>
                        <TableColumn fx:id="colStavkaBodovi" text="Bodovi" prefWidth="90"/>
                        <TableColumn fx:id="colVerifikovan" text="Provjereno" prefWidth="100"/>
                    </columns>
                </TableView>

                <Label text="Priloženi dokumenti" styleClass="card-title"/>

                <TableView fx:id="tblDokumenti" styleClass="table-modern" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNaziv" text="Naziv" prefWidth="220"/>
                        <TableColumn fx:id="colVrsta" text="Vrsta" prefWidth="220"/>
                        <TableColumn fx:id="colDatum" text="Datum" prefWidth="110"/>
                        <TableColumn fx:id="colDostavljen" text="Dostavljen" prefWidth="100"/>
                        <TableColumn fx:id="colPregled" text="" prefWidth="110"/>
                    </columns>
                </TableView>

                <VBox fx:id="emptyState" visible="false" managed="false" spacing="6" styleClass="empty-card">
                    <Label text="Nema priloženih dokumenata" styleClass="empty-title"/>
                    <Label text="Student još nije priložio nijedan dokument." styleClass="empty-subtitle"/>
                </VBox>

                <HBox alignment="CENTER_LEFT" styleClass="delete-zone">
                    <Button fx:id="btnObrisi" text="Obriši prijavu" onAction="#onObrisiPrijavu"
                            styleClass="btn-danger" prefWidth="120"/>
                </HBox>
            </VBox>

            <!-- DESNO: sažetak, podaci, akcije -->
            <VBox spacing="14" styleClass="side-panel" GridPane.columnIndex="1">

                <VBox styleClass="stat-card">
                    <Label text="Bodovi (potvrđeno / moguće)" styleClass="stat-title"/>
                    <Label fx:id="lblUkupniBodoviValue" text="—" styleClass="stat-value"/>
                </VBox>

                <VBox styleClass="stat-card">
                    <Label text="Priloženi dokumenti" styleClass="stat-title"/>
                    <Label fx:id="lblDostavljeniCount" text="0" styleClass="stat-value"/>
                </VBox>

                <VBox styleClass="stat-card">
                    <Label text="Status obrade" styleClass="stat-title"/>
                    <Label fx:id="lblStatusObrade" styleClass="stat-value-small"/>
                </VBox>

                <VBox spacing="6" styleClass="stat-card">
                    <Label text="Podaci prijave" styleClass="stat-title"/>
                    <Label fx:id="lblPodaci" wrapText="true"/>
                </VBox>

                <VBox spacing="10" styleClass="stat-card">
                    <Label text="Promijeni status" styleClass="stat-title"/>
                    <ComboBox fx:id="cmbStatusPrijave" styleClass="combo-modern"/>
                    <Button fx:id="btnSacuvajStatus" text="Sačuvaj status"
                            onAction="#onSacuvajStatus" styleClass="btn-primary"/>
                    <Button fx:id="btnPosaljiEmail" text="Pošalji email studentu"
                            onAction="#onPosaljiEmail" styleClass="btn-secondary"/>
                </VBox>
            </VBox>
        </GridPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="footer">
            <Button text="Zatvori" onAction="#onZatvori" defaultButton="true"/>
        </HBox>
    </bottom>
</BorderPane>