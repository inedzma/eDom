<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane styleClass="pr-root" stylesheets="@../styles/prijave.css"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.DetaljiPrijaveController"
            prefWidth="1250" prefHeight="820">

    <!-- ================= ZAGLAVLJE U BOJI ================= -->
    <top>
        <VBox styleClass="pr-hero" spacing="16">
            <BorderPane.margin><Insets top="20" right="24" left="24"/></BorderPane.margin>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="2">
                    <Label fx:id="lblPrijavaId" styleClass="pr-hero-eyebrow" text="PRIJAVA"/>
                    <Label fx:id="lblNaslov" styleClass="pr-hero-naslov" text="Učitavanje…"/>
                    <Label fx:id="lblInfo" styleClass="pr-hero-podnaslov"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblStatus" styleClass="pr-status"/>
                <Button onAction="#onZatvori" styleClass="pr-btn-glass" text="Zatvori"/>
            </HBox>

            <!-- pločice (pravi kontroler) -->
            <HBox fx:id="boxStatistika" spacing="12"/>
        </VBox>
    </top>

    <!-- ================= SADRŽAJ ================= -->
    <center>
        <GridPane hgap="18">
            <padding><Insets top="18" right="24" bottom="24" left="24"/></padding>
            <columnConstraints>
                <ColumnConstraints percentWidth="64"/>
                <ColumnConstraints percentWidth="36"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS"/>
            </rowConstraints>

            <!-- LIJEVO: bodovanje i dokumenti (paneli iz koda) -->
            <ScrollPane styleClass="pr-scroll" fitToWidth="true" hbarPolicy="NEVER" GridPane.columnIndex="0">
                <VBox fx:id="lijevaKolona" spacing="18">
                    <padding><Insets right="6"/></padding>
                </VBox>
            </ScrollPane>

            <!-- DESNO: status, napomena studenta, podaci -->
            <ScrollPane styleClass="pr-scroll" fitToWidth="true" hbarPolicy="NEVER" GridPane.columnIndex="1">
                <VBox spacing="16">
                    <padding><Insets right="6"/></padding>

                    <VBox styleClass="pr-kartica" spacing="10">
                        <Label styleClass="pr-kartica-naslov" text="Status prijave"/>
                        <ComboBox fx:id="cmbStatusPrijave" styleClass="pr-combo" maxWidth="Infinity"/>
                        <Label fx:id="lblStatusPomoc" styleClass="pr-sitno" wrapText="true"
                               visible="false" managed="false"/>
                        <Label styleClass="pr-polje-naslov" text="Napomena za studenta (ide u e-mail)"/>
                        <TextArea fx:id="txtNapomenaAdmina" styleClass="pr-textarea" prefRowCount="3" wrapText="true"
                                  promptText="Obavezna kod statusa „nepotpuna“ i „odbijeno“."/>
                        <Button fx:id="btnSacuvajStatus" onAction="#onSacuvajStatus"
                                styleClass="pr-btn-primarno" maxWidth="Infinity" text="Sačuvaj status"/>
                    </VBox>

                    <VBox fx:id="napomenaMjesto"/>

                    <VBox styleClass="pr-kartica" spacing="12">
                        <Label styleClass="pr-kartica-naslov" text="Podaci prijave"/>
                        <GridPane fx:id="gridPodaci" hgap="14" vgap="8">
                            <columnConstraints>
                                <ColumnConstraints minWidth="130" prefWidth="140"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                        </GridPane>
                    </VBox>
                </VBox>
            </ScrollPane>
        </GridPane>
    </center>
</BorderPane>