<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.RangListaController"
            stylesheets="@../styles/rang-lista-style.css"
            styleClass="rang-root">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="rang-header">
            <VBox spacing="2">
                <Label text="Rang lista studenata" styleClass="rang-title"/>
                <Label fx:id="lblGodina" text=""/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <VBox styleClass="rang-card" spacing="14">

            <HBox spacing="10" alignment="CENTER_LEFT">
                <ToggleButton fx:id="btnBrucosi" text="Brucoši"/>
                <ToggleButton fx:id="btnVisi" text="Više godine"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="⟳" onAction="#onRefresh"/>
                <MenuBar>
                    <Menu fx:id="menuKolone" text="Prikaži kolone"/>
                </MenuBar>
            </HBox>

            <TableView fx:id="tblRangLista" VBox.vgrow="ALWAYS" styleClass="rang-table">
                <columns>
                    <TableColumn fx:id="colRedniBroj" text="R.br" prefWidth="60" styleClass="centered-cell"/>
                    <TableColumn fx:id="colIdPrijave" text="ID prijave" prefWidth="80" styleClass="centered-cell"/>
                    <TableColumn fx:id="colImePrezime" text="Prezime (ime oca) ime" prefWidth="260"/>
                    <TableColumn fx:id="colGodinaStudija" text="Godina" prefWidth="80" styleClass="centered-cell"/>
                    <TableColumn fx:id="colUspjeh" text="Uspjeh" prefWidth="90" styleClass="centered-cell"/>
                    <TableColumn fx:id="colUdaljenost" text="Udaljenost" prefWidth="90" styleClass="centered-cell"/>
                    <TableColumn fx:id="colPrimanja" text="Primanja" prefWidth="90" styleClass="centered-cell"/>
                    <TableColumn fx:id="colBranioci" text="Branioci" prefWidth="90" styleClass="centered-cell"/>
                    <TableColumn fx:id="colDodatni" text="Dodatni" prefWidth="90" styleClass="centered-cell"/>
                    <TableColumn fx:id="colUkupniBodovi" text="Ukupno" prefWidth="110" styleClass="centered-cell"/>
                    <TableColumn fx:id="colDetalji" text="" prefWidth="110"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="btnExportHtmlPdf" text="Export PDF (HTML)" onAction="#onExportHtmlPdf"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>