<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.RangListaController"
            stylesheets="@../styles/rang-lista-style.css"
            styleClass="rang-root">

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="rang-header">
            <VBox spacing="2">
                <Label text="Rang lista studenata" styleClass="rang-title"/>
                <Label fx:id="lblGodina" text=""/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <center>
        <VBox styleClass="rang-card" spacing="10">

            <HBox spacing="10" alignment="CENTER_LEFT">
                <ToggleButton fx:id="btnBrucosi" text="Brucoši"/>
                <ToggleButton fx:id="btnSaUslovom" text="S uslovom"/>
                <ToggleButton fx:id="btnCekanje" text="Lista čekanja"/>
                <ToggleButton fx:id="btnSve" text="Sve"/>
                <Region HBox.hgrow="ALWAYS"/>
                <CheckBox fx:id="chkPopuniBrucosima" text="Slobodna mjesta popuni brucošima"/>
                <Button text="⟳" onAction="#onRefresh"/>
                <MenuBar>
                    <Menu fx:id="menuKolone" text="Prikaži kolone"/>
                </MenuBar>
            </HBox>

            <Label fx:id="lblSazetak" styleClass="rang-sazetak" wrapText="true"/>

            <!-- kolone pravi RangListaController.napraviKolone() -->
            <TableView fx:id="tblRangLista" VBox.vgrow="ALWAYS" styleClass="rang-table"/>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Export PDF…" onAction="#onExportHtmlPdf"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>