<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.NovaPrijavaController"
            styleClass="scroll-pane"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED">

    <stylesheets>
        <URL value="@../styles/nova-prijava-style.css"/>
        <URL value="@../styles/dodaj-dokument-style.css"/>
    </stylesheets>

    <content>
        <StackPane styleClass="page-wrapper">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <VBox styleClass="card" spacing="18">

                <VBox spacing="6">
                    <Label text="Nova prijava: domaćinstvo" styleClass="page-title"/>
                    <Label text="Članovi domaćinstva, njihova primanja i udaljenost." styleClass="page-subtitle"/>
                </VBox>

                <VBox spacing="10">
                    <ProgressBar fx:id="traka" styleClass="progress-top"/>
                    <HBox fx:id="stepper" styleClass="stepper"/>
                </VBox>

                <Label text="Domaćinstvo" styleClass="section-pill"/>
                <Separator styleClass="soft-separator"/>

                <GridPane hgap="22" vgap="16" styleClass="form-grid">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Broj članova domaćinstva (sa studentom)" styleClass="field-label"/>
                        <TextField fx:id="txtClanovi" promptText="4" styleClass="field"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Udaljenost do doma (km)" styleClass="field-label"/>
                        <TextField fx:id="txtUdaljenost" promptText="43" styleClass="field"/>
                    </VBox>
                </GridPane>

                <Label text="Članovi domaćinstva" styleClass="section-pill"/>
                <Separator styleClass="soft-separator"/>

                <VBox fx:id="vboxClanovi" spacing="12"/>
                <Label fx:id="lblUkupno" styleClass="field-label"/>

                <HBox alignment="CENTER" spacing="16" styleClass="footer-box">
                    <Button text="← Nazad" onAction="#onNazad" styleClass="btn-back"/>
                    <Button text="Dalje →" onAction="#onDalje" styleClass="btn-next"/>
                </HBox>

            </VBox>
        </StackPane>
    </content>
</ScrollPane>