<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.DodajDokumenteController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="scroll-pane"
            stylesheets="@../styles/dodaj-dokument-style.css">

    <content>
        <StackPane styleClass="page-wrapper">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <VBox styleClass="card" spacing="18">

                <VBox spacing="6">
                    <Label text="Nova prijava: dokumenti" styleClass="page-title"/>
                    <Label text="Označite koje je dokumente student donio. Spisak je isti kao na webu."
                           styleClass="page-subtitle"/>
                </VBox>

                <VBox spacing="10">
                    <ProgressBar fx:id="traka" styleClass="progress-top"/>
                    <HBox fx:id="stepper" styleClass="stepper"/>
                </VBox>

                <Label fx:id="lblNapredak" styleClass="field-label"/>
                <Label fx:id="lblUcitavanje" wrapText="true" styleClass="doc-subtitle"/>

                <VBox fx:id="vboxSpisak" spacing="14"/>

                <HBox alignment="CENTER" spacing="16" styleClass="footer-box">
                    <Button text="← Nazad" onAction="#onNazad" styleClass="btn-back"/>
                    <Button fx:id="btnDalje" text="Dalje →" onAction="#onDalje" styleClass="btn-next"/>
                </HBox>

            </VBox>
        </StackPane>
    </content>
</ScrollPane>