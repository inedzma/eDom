<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.NoviStudentController"
            stylesheets="@../styles/novi-student-style.css"
            styleClass="scroll-pane"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED">

    <content>
        <StackPane styleClass="page-wrapper">
            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <VBox styleClass="card" spacing="18">

                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox spacing="6">
                        <Label text="Nova prijava: student i studij" styleClass="page-title"/>
                        <Label text="Unesite podatke o studentu, lične podatke i podatke o studiju."
                               styleClass="page-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <Label fx:id="lblPostojeci" visible="false" managed="false"
                       wrapText="true" styleClass="page-subtitle"/>

                <VBox spacing="10">
                    <ProgressBar fx:id="traka" styleClass="progress-top" maxWidth="Infinity"/>
                    <HBox fx:id="stepper" styleClass="stepper"/>
                </VBox>

                <!-- ================= OSNOVNE INFORMACIJE ================= -->
                <Label text="Osnovne informacije" styleClass="section-pill"/>
                <Separator styleClass="soft-separator"/>

                <GridPane hgap="22" vgap="16" styleClass="form-grid">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Ime" styleClass="field-label"/>
                        <TextField fx:id="txtIme" promptText="Unesite ime" styleClass="field"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Prezime" styleClass="field-label"/>
                        <TextField fx:id="txtPrezime" promptText="Unesite prezime" styleClass="field"/>
                    </VBox>

                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="JMBG" styleClass="field-label"/>
                        <TextField fx:id="txtJMBG" promptText="13 cifara" styleClass="field"/>
                        <Label fx:id="lblSpol" styleClass="page-subtitle"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Ime jednog roditelja" styleClass="field-label"/>
                        <TextField fx:id="txtRoditelj" promptText="Ime roditelja" styleClass="field"/>
                    </VBox>

                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label text="Email" styleClass="field-label"/>
                        <TextField fx:id="txtEmail" promptText="ime.prezime@email.com" styleClass="field"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Label text="Telefon" styleClass="field-label"/>
                        <TextField fx:id="txtTelefon" promptText="+387..." styleClass="field"/>
                    </VBox>

                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="3">
                        <Label text="Adresa stanovanja" styleClass="field-label"/>
                        <TextField fx:id="txtAdresa" promptText="Grad, ulica" styleClass="field"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="3">
                        <Label text="Socijalni status" styleClass="field-label"/>
                        <ComboBox fx:id="cmbSocijalniStatus" promptText="Odaberi status"
                                  styleClass="combo" maxWidth="Infinity"/>
                    </VBox>
                </GridPane>

                <!-- ================= LIČNI PODACI ZA PRIJAVU ================= -->
                <Label text="Lični podaci" styleClass="section-pill"/>
                <Separator styleClass="soft-separator"/>

                <GridPane hgap="22" vgap="16" styleClass="form-grid">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Broj lične karte" styleClass="field-label"/>
                        <TextField fx:id="txtLicnaKarta" promptText="npr. 1E2A3B4C5" styleClass="field"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Telefon roditelja" styleClass="field-label"/>
                        <TextField fx:id="txtTelefonRoditelja" promptText="+387..." styleClass="field"/>
                    </VBox>

                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Kanton / entitet prebivališta" styleClass="field-label"/>
                        <ComboBox fx:id="cmbKanton" promptText="Odaberi kanton"
                                  styleClass="combo" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Općina / grad prebivališta" styleClass="field-label"/>
                        <ComboBox fx:id="cmbOpcina" promptText="Prvo odaberi kanton"
                                  styleClass="combo" maxWidth="Infinity"/>
                    </VBox>
                </GridPane>

                <!-- ================= STUDIJ ================= -->
                <Label text="Studij" styleClass="section-pill"/>
                <Separator styleClass="soft-separator"/>

                <GridPane hgap="22" vgap="16" styleClass="form-grid">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Fakultet" styleClass="field-label"/>
                        <ComboBox fx:id="cmbFakultet" promptText="Odaberi fakultet"
                                  styleClass="combo" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Broj indeksa" styleClass="field-label"/>
                        <TextField fx:id="txtIndeks" promptText="npr. 421" styleClass="field"/>
                    </VBox>

                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Akademska godina (početna)" styleClass="field-label"/>
                        <TextField fx:id="txtAkGod" promptText="2026" styleClass="field"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Godina studija" styleClass="field-label"/>
                        <ComboBox fx:id="cmbGodina" promptText="Odaberi godinu"
                                  styleClass="combo" maxWidth="Infinity"/>
                    </VBox>

                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label text="Koji put upisuje ovu godinu" styleClass="field-label"/>
                        <ComboBox fx:id="cmbUpisPut" styleClass="combo" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Label text="Prosjek" styleClass="field-label"/>
                        <TextField fx:id="txtProsjek" promptText="npr. 8.6" styleClass="field"/>
                    </VBox>

                    <VBox fx:id="boxIspiti" spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="3">
                        <Label text="Broj položenih ispita" styleClass="field-label"/>
                        <TextField fx:id="txtIspiti" promptText="npr. 12" styleClass="field"/>
                    </VBox>
                </GridPane>

                <HBox alignment="CENTER" spacing="16" styleClass="footer-box">
                    <Button text="← Nazad" onAction="#onBackClicked" styleClass="btn-back"/>
                    <Button text="Dalje →" onAction="#onNextClicked" styleClass="btn-next"/>
                </HBox>

            </VBox>
        </StackPane>
    </content>
</ScrollPane>