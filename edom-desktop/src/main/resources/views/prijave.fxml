<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<AnchorPane styleClass="pr-root" stylesheets="@../styles/prijave.css"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.prijaveController">

    <VBox spacing="16" AnchorPane.topAnchor="24" AnchorPane.rightAnchor="28"
          AnchorPane.bottomAnchor="24" AnchorPane.leftAnchor="28">

        <!-- ================= ZAGLAVLJE ================= -->
        <HBox alignment="CENTER_LEFT" spacing="10">
            <VBox spacing="2">
                <Label styleClass="pr-naslov" text="Prijave"/>
                <Label fx:id="lblPodnaslov" styleClass="pr-podnaslov" text="Učitavanje…"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#onRefresh" styleClass="pr-btn-ikona" text="⟳">
                <tooltip><Tooltip text="Osvježi podatke"/></tooltip>
            </Button>
            <Button onAction="#onNovaPrijava" styleClass="pr-btn-primarno" text="+  Nova prijava"/>
        </HBox>

        <!-- ================= STATUSI (pilule s brojem) ================= -->
        <FlowPane fx:id="boxStatusi" hgap="8" vgap="8"/>

        <!-- ================= KARTICA ================= -->
        <VBox styleClass="pr-kartica" spacing="14" VBox.vgrow="ALWAYS">

            <HBox alignment="CENTER_LEFT" spacing="10">
                <HBox styleClass="pr-pretraga" alignment="CENTER_LEFT" spacing="8"
                      HBox.hgrow="ALWAYS" maxWidth="440">
                    <SVGPath styleClass="pr-pretraga-ikona"
                             content="M10 2a8 8 0 1 0 4.9 14.3l5.4 5.4 1.4-1.4-5.4-5.4A8 8 0 0 0 10 2zm0 2a6 6 0 1 1 0 12 6 6 0 0 1 0-12z"/>
                    <TextField fx:id="txtSearch" styleClass="pr-pretraga-polje" HBox.hgrow="ALWAYS"
                               promptText="Pretraga: ime, prezime, indeks, fakultet, napomena…"/>
                </HBox>

                <MenuButton styleClass="pr-meni" text="Filtriraj">
                    <items>
                        <Menu fx:id="menuFakulteti" text="Fakultet"/>
                        <Menu fx:id="menuGodineStudija" text="Godina studija"/>
                    </items>
                </MenuButton>

                <MenuButton styleClass="pr-meni" text="Sortiraj">
                    <items>
                        <MenuItem onAction="#sortNajnovije" text="Najnovije prvo"/>
                        <MenuItem onAction="#sortNajstarije" text="Najstarije prvo"/>
                        <SeparatorMenuItem/>
                        <MenuItem onAction="#sortPrezimeAZ" text="Prezime A–Z"/>
                        <MenuItem onAction="#sortPrezimeZA" text="Prezime Z–A"/>
                        <SeparatorMenuItem/>
                        <MenuItem onAction="#sortBodoviSilazno" text="Bodovi: najviše prvo"/>
                        <MenuItem onAction="#sortBodoviUzlazno" text="Bodovi: najmanje prvo"/>
                    </items>
                </MenuButton>

                <Button fx:id="btnOcisti" onAction="#onOcisti" styleClass="pr-link" text="Očisti filtere"/>
            </HBox>

            <TableView fx:id="tblPrijave" styleClass="pr-tabela" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="#" prefWidth="60"/>
                    <TableColumn fx:id="colStudent" text="STUDENT" prefWidth="270"/>
                    <TableColumn fx:id="colGodina" text="GODINA" prefWidth="100"/>
                    <TableColumn fx:id="colDatum" text="PODNESENA" prefWidth="110"/>
                    <TableColumn fx:id="colBodovi" text="BODOVI" prefWidth="170"/>
                    <TableColumn fx:id="colDokumenti" text="DOK." prefWidth="60"/>
                    <TableColumn fx:id="colStatus" text="STATUS" prefWidth="140"/>
                    <TableColumn fx:id="colNapomena" text="NAPOMENA" prefWidth="260"/>
                </columns>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="lblPrikazano" styleClass="pr-sitno"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label styleClass="pr-sitno" text="Dvoklik na red otvara detalje prijave"/>
                <Button fx:id="btnExportHtmlPdf" onAction="#onExportHtmlPdf" styleClass="pr-btn-sekundarno" text="Izvezi PDF"/>
            </HBox>
        </VBox>
    </VBox>
</AnchorPane>